{
  "name": "charger-dashboard-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:backend": "python -m unittest discover -s server/tests -t server -v",
    "test:all": "npm test && npm run test:backend"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "26.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@angular/build": {
      "piscina": "5.3.2"
    }
  }
}
